#!/bin/sh
set -e

# ── R binary detection ──────────────────────────────────────────────────────
R_BIN="${R_HOME:+$R_HOME/bin/R}"
if [ -z "$R_BIN" ] || [ ! -x "$R_BIN" ]; then
  R_BIN=$(command -v R || true)
fi
if [ -z "$R_BIN" ]; then
  echo "configure: error: R executable not found" 1>&2
  exit 1
fi

R_INCL=$("$R_BIN" CMD config --cppflags)

# ── NVML detection ──────────────────────────────────────────────────────────
HAVE_NVML=0
NVML_CFLAGS=
NVML_LIBS=

if pkg-config --exists nvml 2>/dev/null; then
  NVML_CFLAGS=$(pkg-config --cflags nvml)
  NVML_LIBS=$(pkg-config --libs nvml)
  HAVE_NVML=1
fi

if [ "$HAVE_NVML" -eq 0 ] && [ -n "$NVML_INCLUDE_DIR" ] && [ -n "$NVML_LIB_DIR" ]; then
  if [ -f "$NVML_INCLUDE_DIR/nvml.h" ] && [ -f "$NVML_LIB_DIR/libnvidia-ml.so" ]; then
    NVML_CFLAGS="-I${NVML_INCLUDE_DIR}"
    NVML_LIBS="-L${NVML_LIB_DIR} -lnvidia-ml"
    HAVE_NVML=1
  fi
fi

find_nvml_in_tree() {
  base="$1"
  for inc in "$base/include" "$base/targets/"*"/include"; do
    [ -f "$inc/nvml.h" ] || continue
    for lib in "$base/targets/"*"/lib/stubs" "$base/lib64" "$base/lib"; do
      [ -f "$lib/libnvidia-ml.so" ] || continue
      NVML_INCLUDE_DIR="$inc"
      NVML_LIB_DIR="$lib"
      NVML_CFLAGS="-I${NVML_INCLUDE_DIR}"
      NVML_LIBS="-L${NVML_LIB_DIR} -lnvidia-ml"
      HAVE_NVML=1
      return 0
    done
  done
  return 1
}

if [ "$HAVE_NVML" -eq 0 ]; then
  bases=""
  [ -n "${CUDA_HOME:-}" ] && bases="$CUDA_HOME"
  [ -n "${CUDA_PATH:-}" ] && bases="$bases $CUDA_PATH"
  bases="$bases /usr/local/cuda"
  for d in /usr/local/cuda-*; do
    [ -d "$d" ] && bases="$bases $d"
  done

  for base in $bases; do
    [ -d "$base" ] || continue
    if find_nvml_in_tree "$base"; then
      break
    fi
  done
fi

# ── Avoid linking NVML stubs when libnvidia-ml.so.1 is not available ────────
if [ "$HAVE_NVML" -eq 1 ] && echo "$NVML_LIB_DIR" | grep -q '/stubs$' && ! ldconfig -p 2>/dev/null | grep -q 'libnvidia-ml[.]so[.]1'; then
  HAVE_NVML=0
fi

# ── Conditional output & Makevars generation ────────────────────────────────
if [ "$HAVE_NVML" -eq 1 ]; then
  echo "configure: NVML support enabled"
  echo "configure: NVML include dir: ${NVML_INCLUDE_DIR}"
  echo "configure: NVML lib dir: ${NVML_LIB_DIR}"
  PKG_CPPFLAGS="${R_INCL} ${NVML_CFLAGS} -DHAVE_NVML=1"
  PKG_LIBS="${NVML_LIBS} ${SHLIB_LINK}"
else
  echo "configure: NVML support disabled; building stub implementation"
  PKG_CPPFLAGS="${R_INCL}"
  PKG_LIBS="${SHLIB_LINK}"
fi

sed \
  -e "s|@PKG_CPPFLAGS@|${PKG_CPPFLAGS}|g" \
  -e "s|@PKG_LIBS@|${PKG_LIBS}|g" \
  src/Makevars.in > src/Makevars
